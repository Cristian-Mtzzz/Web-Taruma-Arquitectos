# Credenciales del sitio, en claro y versionadas a propósito.
#
# Next.js carga este archivo solo (no hace falta instalar nada ni pasar flags).
# Decisión consciente del proyecto: no se usan secretos ni .env.local.
#
# AVISO: una contraseña de aplicación de Gmail da acceso completo por SMTP e
# IMAP a la cuenta. Si este repositorio se publica en GitHub, revócala desde
# https://myaccount.google.com/apppasswords y genera otra.

# Cuenta de Gmail que ENVÍA los correos del formulario
GMAIL_USER=tarumadmn@gmail.com

# Contraseña de aplicación de 16 caracteres, SIN espacios.
# Se genera en https://myaccount.google.com/apppasswords
# (requiere verificación en dos pasos activada en la cuenta)
GMAIL_APP_PASSWORD=tjyfniiyrsbrrboh

# Dónde llegan las consultas y las cotizaciones
CONTACT_TO=tarumadmn@gmail.com
